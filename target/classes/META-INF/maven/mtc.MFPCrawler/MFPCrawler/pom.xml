<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>mtc.MFPCrawler</groupId>
	<artifactId>MFPCrawler</artifactId>
	<version>1.0.0-SNAPSHOT</version>

	<properties>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<app.main.class>mtc.MFPCrawler.MFPCrawler</app.main.class>
	</properties>

	<build>
		<plugins>
			<!-- 1. Configurazione Fat JAR con Splash-Screen nel Manifest -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.4.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${app.main.class}</mainClass>
									<!-- Percorso dell'immagine Splash all'interno delle risorse (src/main/resources/splash.png) -->
									<manifestEntries>
										<SplashScreen-Image>splash.png</SplashScreen-Image>
									</manifestEntries>
								</transformer>
							</transformers>
							<finalName>${project.artifactId}-fat</finalName>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- 2. Configurazione jpackage per Installer Windows completo -->
			<plugin>
				<groupId>org.panteleyev</groupId>
				<artifactId>jpackage-maven-plugin</artifactId>
				<version>1.4.0</version>
				<configuration>
					<name>MFPCrawler</name>
					<appVersion>1.0.0</appVersion>
					<vendor>Mitch Pisa</vendor>
					<destination>target/dist</destination>
					<mainClass>${app.main.class}</mainClass>
					<mainJar>MFPCrawler-fat.jar</mainJar>
					<input>target</input>
					<type>EXE</type>
					
					<!-- Icona personalizzata per l'applicazione e l'installer (.ico necessario su Windows) -->
					 <icon>${project.basedir}/src/main/resources/icon.ico</icon>
					
					<!-- Abilita la possibilità per l'utente di scegliere la directory di installazione -->
					<winDirChooser>true</winDirChooser>
					
					<!-- Menu Start e Desktop -->
					<windowsMenu>true</windowsMenu>
					<windowsMenuGroup>Mitch Pisa</windowsMenuGroup>
					<windowsShortcut>true</windowsShortcut>
					<windowsInstallerMenu>true</windowsInstallerMenu>
					
					<runtimeImage>${java.home}</runtimeImage>
				</configuration>
				<executions>
					<execution>
						<phase>verify</phase>
						<goals>
							<goal>jpackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>org.snmp4j</groupId>
			<artifactId>snmp4j</artifactId>
			<version>3.7.7</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.17.2</version>
		</dependency>
	</dependencies>

	<repositories>
		<repository>
			<id>oosnmp-repo</id>
			<name>OO-SNMP Repository</name>
			<url>https://oosnmp.net/dist/release/</url>
		</repository>
	</repositories>
	<name>MFPCrawler</name>
	<description>Find snmp MFP in local network</description>
</project>