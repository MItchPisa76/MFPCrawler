<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>mtc.MFPCrawler</groupId>
	<artifactId>MFPCrawler</artifactId>
	<version>1.0.0-SNAPSHOT</version>

	<properties>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<app.main.class>mtc.MFPCrawler.MFPCrawler</app.main.class>
	</properties>

	<build>
		<plugins>
			<!-- 1. Configurazione Fat JAR (Include dipendenze e Splash Screen) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.4.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${app.main.class}</mainClass>
									<manifestEntries>
										<!-- Imm. Splash dentro src/main/resources/splash.png -->
										<SplashScreen-Image>splash.png</SplashScreen-Image>
									</manifestEntries>
								</transformer>
							</transformers>
							<finalName>${project.artifactId}-fat</finalName>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- 2. Configurazione jpackage con TUTTI I PARAMETRI -->
			<plugin>
				<groupId>org.panteleyev</groupId>
				<artifactId>jpackage-maven-plugin</artifactId>
				<version>1.6.0</version>
				<configuration>
					<!-- ==================================================== -->
					<!-- PARAMETRI GENERALI DELL'APPLICAZIONE                -->
					<!-- ==================================================== -->
					<!-- Nome dell'applicazione ed eseguibile (.exe) -->
					<name>MFPCrawler</name>
					
					<!-- Versione (Formato numerico puro: es. 1.0.0) -->
					<appVersion>1.0.0</appVersion>
					
					<!-- Produttore / Autore -->
					<vendor>Mitch Pisa</vendor>
					
					<!-- Descrizione visibile nelle proprietà del file Windows -->
					<description>Find SNMP MFP in local network</description>
					
					<!-- Informazioni sul Copyright -->
					<copyright>Copyright 2026 Mitch Pisa</copyright>
					
					<!-- Classe Main dell'applicazione -->
					<mainClass>${app.main.class}</mainClass>
					
					<!-- JAR principale con tutte le dipendenze -->
					<mainJar>MFPCrawler-fat.jar</mainJar>
					
					<!-- Directory contenente il file JAR (target) -->
					<input>target</input>
					
					<!-- Directory di destinazione per l'installer generato -->
					<destination>target/dist</destination>
					
					<!-- Tipo di pacchetto: EXE o MSI -->
					<type>EXE</type>
					
					<!-- Path assoluto dell'icona (.ico per Windows) -->
					<icon>${project.basedir}/src/main/resources/icon.ico</icon>
					
					<!-- JRE o JDK da includere nel bundle -->
					<runtimeImage>${java.home}</runtimeImage>

					<!-- ==================================================== -->
					<!-- PARAMETRI SPECIFICI PER WINDOWS E MENU START        -->
					<!-- ==================================================== -->
					<!-- Forza la creazione della voce nel Menu Start -->
					<winMenu>true</winMenu>
					
					<!-- Lascia vuoto o ometti per posizionare l'icona direttamente 
					     nella radice delle app del Menu Start di Win 10/11 -->
					<winMenuGroup>MFPCrawler</winMenuGroup>

					<!-- Crea il collegamento sul Desktop -->
					<winShortcut>true</winShortcut>
					
					<!-- Abilita il bottone 'Sfoglia' per la cartella di installazione -->
					<winDirChooser>true</winDirChooser>

					<!-- Installazione per singolo utente (senza richiedere Admin/UAC).
					     Risolve spesso i problemi di mancata visualizzazione nel Menu Start! -->
					<winPerUserInstall>true</winPerUserInstall>

					<!-- Permette di creare un collegamento nel Menu Start per disinstallare -->
					<winShortcutPrompt>false</winShortcutPrompt>

					<!-- Apre la finestra di console cmd all'avvio (utile per DEBUG) -->
					<winConsole>true</winConsole>

					<!-- ==================================================== -->
					<!-- OPZIONALI: DYNAMIC ARGS E WIX TEMPLATES              -->
					<!-- ==================================================== -->
					<!-- Cartella contenente file di configurazione WiX personalizzati (se usati) -->
					<!-- <resourceDir>${project.basedir}/src/main/jpackage</resourceDir> -->

					<!-- Argomenti della JVM quando l'app viene avviata -->
					<javaOptions>
						<option>-Dfile.encoding=UTF-8</option>
					</javaOptions>
				</configuration>
				<executions>
					<execution>
						<phase>verify</phase>
						<goals>
							<goal>jpackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>org.snmp4j</groupId>
			<artifactId>snmp4j</artifactId>
			<version>3.7.7</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.17.2</version>
		</dependency>
	</dependencies>

	<repositories>
		<repository>
			<id>oosnmp-repo</id>
			<name>OO-SNMP Repository</name>
			<url>https://oosnmp.net/dist/release/</url>
		</repository>
	</repositories>

	<name>MFPCrawler</name>
	<description>Find snmp MFP in local network</description>
</project>