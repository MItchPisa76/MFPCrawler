<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>mtc.MFPCrawler</groupId>
  <artifactId>MFPCrawler</artifactId>
  <name>MFPCrawler</name>
  <version>1.0.0-SNAPSHOT</version>
  <description>Find snmp MFP in local network</description>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>${app.main.class}</mainClass>
                </transformer>
              </transformers>
              <finalName>${project.artifactId}-fat</finalName>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <version>1.4.0</version>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <name>MFPCrawler</name>
          <appVersion>1.0.0</appVersion>
          <vendor>Mitch Pisa</vendor>
          <destination>target/dist</destination>
          <mainClass>${app.main.class}</mainClass>
          <mainJar>${project.build.finalName}-fat.jar</mainJar>
          <input>target</input>
          <type>EXE</type>
          <windowsMenu>true</windowsMenu>
          <windowsMenuGroup>Mitch Pisa</windowsMenuGroup>
          <windowsShortcut>true</windowsShortcut>
          <windowsInstallerMenu>true</windowsInstallerMenu>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <id>oosnmp-repo</id>
      <name>OO-SNMP Repository</name>
      <url>https://oosnmp.net/dist/release/</url>
    </repository>
  </repositories>
  <properties>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.source>17</maven.compiler.source>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <app.main.class>mtc.MFPCrawler.MFPCrawler</app.main.class>
  </properties>
</project>
