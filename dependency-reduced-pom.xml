<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>mtc.MFPCrawler</groupId>
  <artifactId>MFPCrawler</artifactId>
  <name>MFPCrawler</name>
  <version>1.0.0-SNAPSHOT</version>
  <description>Find snmp MFP in local network</description>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>${app.main.class}</mainClass>
                  <manifestEntries>
                    <SplashScreen-Image>splash.png</SplashScreen-Image>
                  </manifestEntries>
                </transformer>
              </transformers>
              <finalName>${project.artifactId}-fat</finalName>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <version>1.6.0</version>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <name>MFPCrawler</name>
          <appVersion>1.0.0</appVersion>
          <vendor>Mitch Pisa</vendor>
          <description>Find SNMP MFP in local network</description>
          <copyright>Copyright 2026 Mitch Pisa</copyright>
          <mainClass>${app.main.class}</mainClass>
          <mainJar>MFPCrawler-fat.jar</mainJar>
          <input>target</input>
          <destination>target/dist</destination>
          <type>EXE</type>
          <icon>${project.basedir}/src/main/resources/icon.ico</icon>
          <runtimeImage>${java.home}</runtimeImage>
          <winMenu>true</winMenu>
          <winMenuGroup>MFPCrawler</winMenuGroup>
          <winShortcut>true</winShortcut>
          <winDirChooser>true</winDirChooser>
          <winPerUserInstall>false</winPerUserInstall>
          <winShortcutPrompt>true</winShortcutPrompt>
          <winConsole>true</winConsole>
          <javaOptions>
            <option>-Dfile.encoding=UTF-8</option>
          </javaOptions>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <id>oosnmp-repo</id>
      <name>OO-SNMP Repository</name>
      <url>https://oosnmp.net/dist/release/</url>
    </repository>
  </repositories>
  <properties>
    <maven.compiler.target>21</maven.compiler.target>
    <maven.compiler.source>21</maven.compiler.source>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <app.main.class>mtc.MFPCrawler.MFPCrawler</app.main.class>
  </properties>
</project>
